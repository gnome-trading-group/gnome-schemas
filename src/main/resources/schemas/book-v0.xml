<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="group.gnometrading.schemas.book.v0"
                   id="2"
                   version="0"
                   semanticVersion="5.2"
                   description="The book family: order book and trade records of a venue listing's stream"
                   byteOrder="littleEndian">
    <!-- Every stream record, in every family, starts with the same five fields at the same offsets (streamId,
         timestampEvent, timestampRecv, sequence, flags), so code that moves, stores or checks records reads them
         without knowing the family. Template ids 100-199 belong to this family; other families have their own
         hundred, so a template id alone names a record in a ring slot or journal. -->
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root.">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <!-- Presence optional is needed so null values are generated correctly -->
        <type name="timestamp" primitiveType="uint64" nullValue="0" presence="optional" />
        <type name="price" primitiveType="int64" nullValue="-9223372036854775808" presence="optional" />
        <type name="size" primitiveType="int64" nullValue="-9223372036854775808" presence="optional" />
        <type name="volume" primitiveType="uint64" /> <!-- Current volume will never be null -->
        <type name="count" primitiveType="uint32" nullValue="4294967295" presence="optional" />
        <type name="depth" primitiveType="uint8" nullValue="255" presence="optional" />
        <type name="sequence" primitiveType="uint64" nullValue="0" presence="optional" />

        <enum name="Action" encodingType="char">
            <validValue name="Add">A</validValue>
            <validValue name="Cancel">C</validValue>
            <validValue name="Modify">M</validValue>
            <validValue name="Clear">W</validValue>
            <validValue name="Trade">T</validValue>
            <validValue name="Fill">F</validValue>
            <validValue name="None">N</validValue>
        </enum>
        <enum name="Side" encodingType="char">
            <validValue name="Ask">A</validValue>
            <validValue name="Bid">B</validValue>
            <validValue name="None">N</validValue>
        </enum>

        <!-- Bits 0-3 mean the same in every family's flags; bits 4-7 are the family's own. badData: the record may
             not reflect the source (a gap, a resync, a lost or silent stream) until a snapshot clears it. -->
        <set name="BookFlags" encodingType="uint8">
            <choice name="badData">0</choice>
            <choice name="snapshot">1</choice>
            <choice name="lastMessage">2</choice>
            <choice name="badTimestampRecv">3</choice>
            <choice name="marketByPrice">4</choice>
            <choice name="topOfBook">5</choice>
        </set>
    </types>
